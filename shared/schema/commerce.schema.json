{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/itdojp/book-formatter/shared/schema/commerce.schema.json",
  "title": "BOOTH plan-only commerce metadata",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "channel": {
      "const": "booth"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
    },
    "sku": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
    },
    "currency": {
      "const": "JPY"
    },
    "price": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "full_edition": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
    },
    "sample_edition": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "[^\\s]"
    },
    "changelog": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "date",
          "changes"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
            "maxLength": 80
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "[^\\s]"
            }
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "channel",
    "slug",
    "sku",
    "currency",
    "price",
    "full_edition",
    "sample_edition",
    "summary",
    "changelog"
  ]
}
