{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/itdojp/book-formatter/shared/schema/book.schema.json",
  "title": "Standard Book Metadata",
  "description": "Canonical metadata for the book-formatter standard source format.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "language",
    "authors",
    "publisher",
    "repository",
    "source",
    "structure",
    "editions",
    "license",
    "version"
  ],
  "properties": {
    "schema_version": {
      "description": "Version of this metadata contract.",
      "const": 1
    },
    "id": {
      "$ref": "#/definitions/id"
    },
    "title": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "language": {
      "description": "BCP 47-style primary language tag.",
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "$ref": "#/definitions/nonEmptyString"
          },
          "url": {
            "$ref": "#/definitions/httpsUrl"
          }
        }
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "url": {
          "$ref": "#/definitions/httpsUrl"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "default_branch"],
      "properties": {
        "url": {
          "$ref": "#/definitions/httpsUrl"
        },
        "default_branch": {
          "type": "string",
          "pattern": "^(?!@$)(?!HEAD$)(?!-)(?!/)(?!\\.)(?!.*\\/\\.)(?!.*\\.\\.)(?!.*@\\{)(?!.*//)(?![^/]*\\.lock(?:/|$))(?!.*\\/[^/]*\\.lock(?:/|$))(?!.*[\\u0000-\\u0020\\u007F~^:?*\\[\\]\\\\])(?!.*[/.]$).+$"
        }
      }
    },
    "source": {
      "description": "Canonical source directories, relative to book.yaml.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manuscript",
        "assets",
        "frontmatter",
        "backmatter",
        "editions"
      ],
      "properties": {
        "manuscript": {
          "$ref": "#/definitions/relativePath"
        },
        "assets": {
          "$ref": "#/definitions/relativePath"
        },
        "frontmatter": {
          "$ref": "#/definitions/relativePath"
        },
        "backmatter": {
          "$ref": "#/definitions/relativePath"
        },
        "editions": {
          "$ref": "#/definitions/relativePath"
        }
      }
    },
    "structure": {
      "description": "Ordered canonical source documents.",
      "type": "object",
      "additionalProperties": false,
      "required": ["frontmatter", "chapters", "backmatter"],
      "properties": {
        "frontmatter": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/structureEntry"
          }
        },
        "chapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/chapterEntry"
          }
        },
        "backmatter": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/structureEntry"
          }
        }
      }
    },
    "editions": {
      "description": "Named publication editions. Visibility fields are optional for backward compatibility and required by the visibility checker.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status"],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "title": {
            "$ref": "#/definitions/nonEmptyString"
          },
          "status": {
            "type": "string",
            "enum": ["draft", "published", "archived"]
          },
          "description": {
            "$ref": "#/definitions/nonEmptyString"
          },
          "visibility": {
            "$ref": "#/definitions/visibility"
          },
          "documents": {
            "description": "Ordered structure IDs included by this edition before block-level visibility filtering.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/definitions/id"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "visibility": {}
              },
              "required": ["visibility"]
            },
            "then": {
              "properties": {
                "documents": {}
              },
              "required": ["documents"]
            }
          },
          {
            "if": {
              "properties": {
                "documents": {}
              },
              "required": ["documents"]
            },
            "then": {
              "properties": {
                "visibility": {}
              },
              "required": ["visibility"]
            }
          }
        ]
      }
    },
    "license": {
      "description": "SPDX identifier or an explicit project license expression.",
      "$ref": "#/definitions/nonEmptyString"
    },
    "version": {
      "description": "Semantic version of the canonical book source.",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "targets": {
      "description": "Optional target-specific publication metadata. Adapter output remains generated and unpublished.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zenn": {
          "$ref": "#/definitions/zennTarget"
        },
        "note": {
          "$ref": "#/definitions/noteTarget"
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "visibility": {
      "type": "string",
      "enum": ["free", "sample", "paid", "internal"]
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^\\s]+$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!/)(?!.*\\\\)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "markdownPath": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!/)(?!.*\\\\)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.md$"
    },
    "structureEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "path"],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "title": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "path": {
          "$ref": "#/definitions/markdownPath"
        },
        "visibility": {
          "$ref": "#/definitions/visibility"
        }
      }
    },
    "chapterEntry": {
      "$ref": "#/definitions/structureEntry"
    },
    "zennTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "summary", "topics"],
      "properties": {
        "slug": {
          "description": "Stable Zenn book slug.",
          "type": "string",
          "pattern": "^[0-9a-z_-]{12,50}$"
        },
        "summary": {
          "description": "Public Zenn book summary.",
          "$ref": "#/definitions/nonEmptyString"
        },
        "topics": {
          "description": "One to five Zenn topics. Each topic is at most 18 characters and contains no ASCII punctuation or whitespace.",
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 18,
            "pattern": "^[^\\u0000-\\u002F\\u003A-\\u0040\\u005B-\\u0060\\u007B-\\u007F]+$"
          }
        },
        "price": {
          "description": "Paid Zenn book price in JPY. Free adapter output writes price 0 instead.",
          "type": "integer",
          "minimum": 200,
          "maximum": 5000,
          "multipleOf": 100
        }
      }
    },
    "noteTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "free_sample_edition", "price", "hashtags"],
      "properties": {
        "slug": {
          "description": "Stable local directory name for the generated note handoff package.",
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "free_sample_edition": {
          "description": "Existing free/sample edition that defines the text above note's paid line.",
          "$ref": "#/definitions/id"
        },
        "price": {
          "description": "Planned article price in JPY under note's standard-account range.",
          "type": "integer",
          "minimum": 100,
          "maximum": 50000
        },
        "hashtags": {
          "description": "One to ten conservative note hashtags without the leading hash sign.",
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "pattern": "^[\\p{Script=Hiragana}\\p{Script=Katakana}\\p{Script=Han}A-Za-z0-9Ａ-Ｚａ-ｚ０-９_〇○ー]+$"
          }
        },
        "attachment_candidates": {
          "description": "Optional PDF paths below source.assets for manual note upload.",
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/relativePath"
          }
        }
      }
    }
  }
}
